{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/dna-screening", "destination": "/dna-screening/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/dna-screening/", "destination": "https://dna-screening-tracker.vercel.app/" },
    { "source": "/dna-screening/:path*", "destination": "https://dna-screening-tracker.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
